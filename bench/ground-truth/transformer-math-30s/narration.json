  "scenes": [
    {
      "scene": 1,
      "text": "Attention starts with one line of math. Here is how it works.",
      "start": 0.1,
      "end": 3.5599,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "c7f9acf1e3af3ad73fd1"
    },
    {
      "scene": 2,
      "text": "Each token becomes a query, a key, and a value, using three learned projections.",
      "start": 4.1,
      "end": 8.8239,
      "speed": 1.101,
      "post_tempo": 1.0,
      "cached_take": "9d14631de0e41dc379ae"
    },
    {
      "scene": 3,
      "text": "Dot products compare each query with every key.",
      "start": 9.1,
      "end": 12.0655,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "fc24b64446f9b7681d2a"
    },
    {
      "scene": 4,
      "text": "Divide by the square root of the key dimension, then apply softmax.",
      "start": 13.1,
      "end": 17.0456,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "8c078354926c147738fb"
    },
    {
      "scene": 5,
      "text": "The weights blend the values into a new vector for each token.",
      "start": 18.1,
      "end": 21.3582,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "b3ab94c7e37c5d0856b7"
    },
    {
      "scene": 6,
      "text": "Transformers add feed-forward layers and residual paths.",
      "start": 23.1,
      "end": 26.532,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "87d88da8686be4417556"
    },
    {
      "scene": 7,
      "text": "That is scaled dot-product attention.",
      "start": 27.1,
      "end": 29.3046,
      "speed": 1.0,
      "post_tempo": 1.0,
      "cached_take": "e62b1025068c64a7a966"
    }
  ],
