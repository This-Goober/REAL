    <library>
        <event name="REAL">
            <project name="REAL in 30 seconds">
                <sequence format="r1" duration="1241/30s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <asset-clip ref="r2" name="B1 hook" start="0s" audioRole="effects" offset="0s" duration="169/30s">
                            <note>narration: Most AI video tools generate a video. REAL edits yours, and shows its work.  |  from C1/C1.79b  |  words 0–13  |  flag text-type: classified as 'caption' by heuristic — confirm title / caption / subtitle in the tracks page</note>
                            <adjust-volume amount="-60dB"/>
                            <title ref="r14" name="B1.L2 — it shows its work" start="3600s" offset="91/30s" duration="19/10s" lane="1">
                                <text>
                                    <text-style ref="ts1">it shows
its work</text-style>
                                </text>
                                <text-style-def id="ts1">
