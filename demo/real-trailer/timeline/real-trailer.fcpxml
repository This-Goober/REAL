                                </text-style-def>
                                <adjust-transform position="0 0"/>
                            </title>
                            <asset-clip ref="r15" name="narration — take-01.wav" start="0s" audioRole="dialogue" offset="0s" duration="76/15s" lane="-1">
                                <note>voice take — which take covers this line has to be confirmed by ear; shows shares edits, generate, most, real, shows (+3.0); narration component / audio asset (+2.0)</note>
                            </asset-clip>
                            <asset-clip ref="r16" name="narration — take-02.wav" start="0s" audioRole="dialogue" offset="86/15s" duration="77/15s" lane="-1">
                                <note>voice take — which take covers this line has to be confirmed by ear; binds_to shares files, four, notebook (+2.0); role shares files, four, notebook (+2.0)</note>
                            </asset-clip>
                            <asset-clip ref="r17" name="narration — take-03.wav" start="0s" audioRole="dialogue" offset="347/30s" duration="143/30s" lane="-1">
                                <note>voice take — which take covers this line has to be confirmed by ear; binds_to shares catalogue (+0.8); role shares catalogue (+0.8)</note>
                            </asset-clip>
