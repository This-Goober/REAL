                        <asset-clip ref="r9" name="B5 payoff" start="0s" audioRole="effects" offset="1871/30s" duration="19s">
                            <note>narration: I'm moving more of my first finger along and my third and fourth finger are not moving as far so they just consequentially get closer to my first finger but actually my first finger is leading majority of the movement.  |  from C5/C5.372  |  words 114–153</note>
                            <adjust-volume amount="-60dB"/>
                            <title ref="r14" name="B5.L2 — let the first finger lead" start="3600s" offset="503/30s" duration="11/5s" lane="1">
                                <param name="Face" key="9999/999166631/999166633/5/999166635/14" enabled="0"/>
