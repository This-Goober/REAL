                        <asset-clip ref="r4" name="B1 hook" start="0s" audioRole="effects" offset="419/30s" duration="79/10s">
                            <note>narration: So I have a community performance today and I'm going to be performing Paganini's 23rd Caprice for solo violin.  |  from C1/C1.ef4  |  words 0–18</note>
                            <adjust-volume amount="-60dB"/>
                            <video ref="r12" name="B1.L2 — Existing crop from the supplied annotated Paganini Caprice No. 23 score, labelled Minore, bars 17–20. Provisional excerpt selection for review." start="0s" offset="53/15s" duration="4s" lane="1"/>
                            <title ref="r14" name="B1.L3 — fingered octaves, Paganini 23" start="3600s" offset="169/30s" duration="19/10s" lane="2">
                                <param name="Face" key="9999/999166631/999166633/5/999166635/14" enabled="0"/>
