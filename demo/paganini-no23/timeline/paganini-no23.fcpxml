                                <param name="Outline" key="9999/999166631/999166633/5/999166635/30" enabled="0"/>
                                <text>
                                    <text-style ref="ts1">fingered octaves,
Paganini 23</text-style>
                                </text>
                                <text-style-def id="ts1">
                                    <text-style font="Helvetica Neue" fontSize="55" fontFace="Bold" alignment="center" shadowColor="0 0 0 0.75" shadowOffset="8 315" shadowBlurRadius="12"/>
                                </text-style-def>
                                <adjust-transform position="0 4.6875"/>
                            </title>
                        </asset-clip>
                        <asset-clip ref="r6" name="B2 intervals shrink up the fingerboard" start="0s" audioRole="effects" offset="328/15s" duration="33/2s">
                            <note>narration: So we all know that for example a whole step down here in first position is obviously larger than a whole step up here. So as you go up the fingerboard the intervals get smaller.  |  from C2/C2.bf0  |  words 19–53</note>
                            <adjust-volume amount="-60dB"/>
                            <video ref="r15" name="B2.L2 — Same whole-step interval with a wider first-position span and a narrower high-position span." start="0s" offset="91/10s" duration="4s" lane="1"/>
                            <title ref="r14" name="B2.L3 — same interval, smaller space" start="3600s" offset="46/3s" duration="7/6s" lane="2">
